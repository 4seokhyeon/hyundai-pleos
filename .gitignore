.gradle/
.kotlin/
**/build/

# Local Android SDK paths and machine-specific settings
local.properties

# Android Studio project settings
.idea/
*.iml

# Native build outputs
.externalNativeBuild/
.cxx/

# macOS / editor temporary files
.DS_Store
.AppleDouble
.LSOverride
*~
*.swp
*.swo

# Debugging and profiling outputs
/captures/
*.log
*.hprof
