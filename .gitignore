# Generated app packages; explicitly allow contest submission APKs in /apk/
*.apk
*.aab
!/apk/*.apk

# Preserve gradlew, gradlew.bat, gradle/wrapper/ and source assets in Git.

# Python experiments, model weights and private recordings
.venv/
venv/
__pycache__/
*.py[cod]
/experiments/singmos/results/
/experiments/singmos/samples/*
!/experiments/singmos/samples/.gitkeep
*.pt
*.pth
*.ckpt
/server/uploads/

